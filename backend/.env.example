# Database — on Railway mount a volume at /app/data
DATABASE_URL=sqlite+aiosqlite:///./data/phrase_feed.db

# Production: URL of your Railway frontend service
# FRONTEND_URL=https://your-frontend.up.railway.app

# CORS (optional, comma-separated JSON list)
# CORS_ORIGINS=["http://localhost:3000"]

# --- LLM Overview ---
# Local dev (Ollama on your Mac):
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2:latest

# Railway / production (Ollama does NOT work in cloud):
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here

# Or disable overview entirely:
# LLM_PROVIDER=none
